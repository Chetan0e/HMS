# Application Environment Configuration

# General
ENV=development
APP_NAME=HMS
PORT=8000
FRONTEND_PORT=3000

# Backend & API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# MongoDB Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=hms_db

# Security & JWT
JWT_SECRET=super-secret-jwt-key-hms-platform-2026-production-change-me
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-hms-platform-2026-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Map Settings
MAP_PROVIDER=leaflet
MAP_API_KEY=

# Seed settings
SEED_ADMIN_EMAIL=admin@hms.com
SEED_ADMIN_PASSWORD=AdminPassword123!
