{
  "name": "hms-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=web\" \"cd backend && python main.py\"",
    "dev:frontend": "npm run dev --workspace=web",
    "dev:backend": "cd backend && python main.py",
    "build": "npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "lint": "npm run lint --workspace=web",
    "test": "npm run test --workspace=web"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2"
  }
}
